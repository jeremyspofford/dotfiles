direction: down
dotfiles: "dotfiles · Plain content\nReal home paths · aliases · skills\nWorks by hand or through Fleet"
dotfleet: {
  label: "Fleet · Manager"
  profile: "Machine profile\nDomain · identity · pins · groups"
  source: "Content converter\nPlain or native chezmoi input"
  home: "chezmoi applies home files\nGit · shell · Mise · local secrets"
  profile -> source: "selects"
  source -> home: "stages"
}
dotfiles -> dotfleet.source: "provides content"
addons: "Future add-ons\nInstall · machine data · teardown contract"
addons -> dotfleet: "extends"
