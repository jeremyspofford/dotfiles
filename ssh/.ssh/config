# ~/.ssh/config
# 1Password manages SSH keys — no private key files on disk.
#
# WSL:   GIT_SSH_COMMAND=ssh.exe in .commonrc routes git through Windows SSH,
#        which talks to 1Password natively. This file is effectively bypassed.
# macOS: Match block selects the 1Password Group Containers socket.
# Linux: Match block selects the standard 1Password CLI agent socket.
#
# Match exec runs the command via /bin/sh -c and matches when it exits 0.
# OpenSSH uses the FIRST matching value for any keyword, so order matters.

# macOS — 1Password agent socket lives inside the app's Group Containers
Match exec "uname | grep -q Darwin"
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# Linux — standard 1Password CLI agent socket
Match exec "uname | grep -q Linux"
  IdentityAgent ~/.1password/agent.sock

# Personal GitHub
Host github.com
  HostName github.com
  User git

# Aria Labs GitHub
Host github.com-arialabs
  HostName github.com
  User git

# Work GitLab
Host gitlab.com
  HostName gitlab.com
  User git
