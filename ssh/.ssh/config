# ~/.ssh/config
# 1Password manages SSH keys — no private key files on disk.
# WSL: GIT_SSH_COMMAND=ssh.exe in .commonrc routes git through Windows SSH.
# macOS/Linux: SSH_AUTH_SOCK points to the 1Password agent socket.

# Personal GitHub
Host github.com
  HostName github.com
  User git

# Aria Labs GitHub
Host github.com-arialabs
  HostName github.com
  User git

# Work GitLab
Host gitlab.com
  HostName gitlab.com
  User git
