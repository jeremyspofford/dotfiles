# ~/.ssh/config
# Git SSH is handled by ssh.exe via core.sshCommand in .gitconfig.
# 1Password on Windows manages keys — no key files needed on WSL.

# Personal GitHub
Host github.com
  HostName github.com
  User git

# Aria Labs GitHub
Host github.com-arialabs
  HostName github.com
  User git

# Work GitLab
Host gitlab.com
  HostName gitlab.com
  User git
