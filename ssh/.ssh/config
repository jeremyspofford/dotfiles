# ~/.ssh/config
# 1Password SSH agent is configured in .commonrc via SSH_AUTH_SOCK (platform-aware).
# No IdentityAgent needed here — SSH uses SSH_AUTH_SOCK automatically.

# Personal GitHub
Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/keys/github-personal.pub

# Aria Labs GitHub
Host github.com-arialabs
  HostName github.com
  User git
  IdentityFile ~/.ssh/keys/github-arialabs.pub

# Work GitLab
Host gitlab.com
  HostName gitlab.com
  User git
  IdentityFile ~/.ssh/keys/gitlab-client.pub
