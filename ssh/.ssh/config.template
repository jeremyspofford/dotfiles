# SSH Config Template
# Copy to ~/.ssh/config and customize

# Global defaults
Host *
    AddKeysToAgent yes
    IdentitiesOnly yes
    ServerAliveInterval 60
    ServerAliveCountMax 3

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github

# Example: Remote server
# Host myserver
#     HostName server.example.com
#     User jeremy
#     IdentityFile ~/.ssh/myserver
#     Port 22

# Example: Jump host / bastion
# Host internal-server
#     HostName 10.0.0.50
#     User jeremy
#     ProxyJump bastion

# Example: Pi (local network)
# Host pi
#     HostName 192.168.0.204
#     User jeremy
#     IdentityFile ~/.ssh/pi
