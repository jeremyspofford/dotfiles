# Portable defaults salvaged from the existing Workbench configuration.
setopt histignorealldups histignorespace histreduceblanks sharehistory interactive_comments
HISTSIZE=10000
SAVEHIST=10000
HISTFILE="$HOME/.zsh_history"
bindkey -e
. "$HOME/.config/dotfiles/interactive.zsh"
. "$HOME/.aliases"
. "$HOME/.config/dotfiles/domain.zsh"
[[ ! -r "$HOME/.secrets" ]] || source "$HOME/.secrets"
if command -v mise >/dev/null 2>&1; then eval "$(mise activate zsh)"; fi

# Native completion: ignore case, group candidates, select with arrow keys.
typeset -U fpath
for _dotfiles_prefix in /opt/homebrew /usr/local; do
  [[ -d "$_dotfiles_prefix/share/zsh/site-functions" ]] && fpath=("$_dotfiles_prefix/share/zsh/site-functions" $fpath)
done
autoload -Uz compinit
_dotfiles_cache="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/zsh"
mkdir -p "$_dotfiles_cache"
compinit -d "$_dotfiles_cache/zcompdump-$ZSH_VERSION"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' group-name ''
zstyle ':completion:*:descriptions' format '%F{cyan}%d%f'
zstyle ':completion:*' list-colors 'di=34' 'ln=36' 'ex=32'
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[[Z' reverse-menu-complete

# Starship is optional; the fallback works with plain zsh.
PROMPT='%F{cyan}%n@%m%f %F{blue}%~%f %# '
if command -v starship >/dev/null 2>&1; then eval "$(starship init zsh)"; fi

# Command-only shells (including agent commands) have no terminal for ZLE.
if [[ -t 0 ]] && command -v fzf >/dev/null 2>&1; then source <(fzf --zsh); fi
ZSH_AUTOSUGGEST_USE_ASYNC=1
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
for _dotfiles_prefix in /opt/homebrew/share /usr/local/share /usr/share; do
  if [[ -r "$_dotfiles_prefix/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
    source "$_dotfiles_prefix/zsh-autosuggestions/zsh-autosuggestions.zsh"
    break
  fi
done

# Highlighting must follow all other widgets and integrations.
for _dotfiles_prefix in /opt/homebrew/share /usr/local/share /usr/share; do
  if [[ -r "$_dotfiles_prefix/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]]; then
    source "$_dotfiles_prefix/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
    break
  fi
done
unset _dotfiles_prefix _dotfiles_cache

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
