# Workbench Git baseline. Identity lives in ~/.config/git/local.gitconfig,
# which is machine-local and included last so it can override anything here.
[init]
    defaultBranch = main
[core]
    editor = nvim
    excludesFile = ~/.config/git/ignore
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
[color]
    ui = auto
[pull]
    ff = only
[push]
    default = simple
[fetch]
    prune = true
[merge]
    conflictStyle = zdiff3
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
[include]
    path = ~/.config/git/local.gitconfig
