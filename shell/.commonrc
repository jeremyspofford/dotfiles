# ~/.commonrc — shared config for bash and zsh
# Sourced by both .bashrc and .zshrc. No shell-specific syntax here.

# ─── Platform detection ───────────────────────────────────────────────
case "$(uname -s)" in
  Darwin) PLATFORM="macos" ;;
  Linux)
    if grep -qi microsoft /proc/version 2>/dev/null; then
      PLATFORM="wsl"
    else
      PLATFORM="linux"
    fi
    ;;
  *) PLATFORM="unknown" ;;
esac
export PLATFORM

# ─── PATH ─────────────────────────────────────────────────────────────
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL" ] && export PATH="$BUN_INSTALL/bin:$PATH"

# Go
[ -d "$HOME/go/bin" ] && export PATH="$HOME/go/bin:$PATH"

# Homebrew (macOS)
if [ "$PLATFORM" = "macos" ]; then
  [ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# ─── Editor ───────────────────────────────────────────────────────────
export EDITOR=nvim
export VISUAL=nvim

# ─── Claude Code ─────────────────────────────────────────────────────
export CLAUDE_CODE_EFFORT_LEVEL=max

# ─── 1Password SSH ───────────────────────────────────────────────────
# WSL:   ssh.exe talks to 1Password agent via Windows named pipe.
# macOS: 1Password agent socket.
# Linux: 1Password agent socket.
case "$PLATFORM" in
  wsl)
    export GIT_SSH_COMMAND="ssh.exe"
    export BROWSER=wslview
    ;;
  macos)
    _sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
    [ -S "$_sock" ] && export SSH_AUTH_SOCK="$_sock"
    unset _sock
    ;;
  linux)
    [ -S "$HOME/.1password/agent.sock" ] && export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
    ;;
esac

# ─── Aliases ──────────────────────────────────────────────────────────
[ -f ~/.aliases ] && . ~/.aliases

# ─── Secrets (never committed) ───────────────────────────────────────
[ -f ~/.secrets ] && . ~/.secrets

# ─── Tool loaders ────────────────────────────────────────────────────
# mise — manages Node, Python, Ruby, bun, and other runtimes
command -v mise >/dev/null 2>&1 && eval "$(mise activate "${SHELL##*/}")"

# ─── Machine-specific overrides ──────────────────────────────────────
[ -f ~/.commonrc.local ] && . ~/.commonrc.local

# pnpm
case "$PLATFORM" in
  macos) export PNPM_HOME="$HOME/Library/pnpm" ;;
  *)     export PNPM_HOME="$HOME/.local/share/pnpm" ;;
esac
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# === WIKI_VAULT: Obsidian LLM Wiki ===
export WIKI_VAULT="$HOME/Obsidian_Vault"
