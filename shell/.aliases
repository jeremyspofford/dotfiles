# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'

# List directory contents — eza if available, fallback to ls
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons'
  alias ll='eza -alF --icons --git'
  alias la='eza -a --icons'
  alias l='eza -F --icons'
  alias lt='eza --tree --icons -L 2'
  alias lsl='eza -l --icons | grep "^l"'
else
  if [ "$PLATFORM" = "macos" ]; then
    alias ls='ls -G'
  else
    alias ls='ls --color=auto'
  fi
  alias ll='ls -alF'
  alias la='ls -A'
  alias l='ls -CF'
  alias lsl='ls -l | grep "^l"'
fi

# Safety nets
alias cp='cp -i'
alias mv='mv -i'
alias mkdir='mkdir -pv'

# Grep with color
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Git shortcuts
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias glog='git log --oneline --graph --decorate -20'

# Common commands
alias c='clear'
alias h='history'
alias j='jobs -l'
alias path='echo -e ${PATH//:/\\n}'
alias now='date +"%Y-%m-%d %H:%M:%S"'

# Disk usage
alias df='df -h'
alias du='du -h'
if [ "$PLATFORM" = "macos" ]; then
  alias duh='du -h -d 1 | sort -hr'
else
  alias duh='du -h --max-depth=1 | sort -hr'
fi

# Process management
alias psg='ps aux | grep -v grep | grep -i'
if [ "$PLATFORM" = "macos" ]; then
  alias topcpu='ps aux -r | head -20'
  alias topmem='ps aux -m | head -20'
else
  alias topcpu='ps aux --sort=-%cpu | head -20'
  alias topmem='ps aux --sort=-%mem | head -20'
fi

# Network
if [ "$PLATFORM" = "macos" ]; then
  alias ports='lsof -iTCP -sTCP:LISTEN -n -P'
else
  alias ports='ss -tulanp'
fi
alias myip='curl -s ifconfig.me'

# Docker
alias d='docker'
alias dc='docker compose'
alias dps='docker ps'
alias dpa='docker ps -a'
alias di='docker images'
alias dex='docker exec -it'
alias dlog='docker logs -f'
alias dprune='docker system prune -af'

# Kubernetes
alias k='kubectl'
alias kgp='kubectl get pods'
alias kgs='kubectl get svc'
alias kgd='kubectl get deployments'
alias kga='kubectl get all'
alias kd='kubectl describe'
alias kl='kubectl logs -f'
alias kex='kubectl exec -it'

# Terraform
alias tf='terraform'
alias tfi='terraform init'
alias tfp='terraform plan'
alias tfa='terraform apply'
alias tfd='terraform destroy'

# Python
alias py='python3'
alias pip='pip3'
alias venv='python3 -m venv'
alias activate='source venv/bin/activate'

# Node / npm
alias ni='npm install'
alias nr='npm run'
alias ns='npm start'
alias nt='npm test'

# Bun
alias bi='bun install'
alias ba='bun add'
alias bad='bun add -d'
alias brm='bun remove'
alias br='bun run'
alias bs='bun start'
alias bt='bun test'
alias bx='bunx'

# bat — syntax-highlighted cat (plain output, no paging)
command -v bat >/dev/null 2>&1 && alias cat='bat --pager=never --style=plain'

# fd — faster find
# Usage: fd <pattern> [path]  (drop-in, no alias needed)

# rg — faster grep
# Usage: rg <pattern> [path]  (drop-in, no alias needed)

# Editors
alias v='nvim'
alias vim='nvim'

# File explorer (platform-aware)
if [ "$PLATFORM" = "wsl" ]; then
  _open_path() { explorer.exe "$(wslpath -w "${1:-.}")" 2>/dev/null; }
  alias start='_open_path'
elif [ "$PLATFORM" = "macos" ]; then
  alias start='open'
elif command -v xdg-open >/dev/null 2>&1; then
  alias start='xdg-open'
fi

# Misc
alias weather='curl wttr.in'
alias serve='python3 -m http.server 8000'
if command -v uuidgen >/dev/null 2>&1; then
  alias uuid='uuidgen | tr "[:upper:]" "[:lower:]"'
fi


# Machine-specific aliases
[ -f ~/.aliases.local ] && . ~/.aliases.local
