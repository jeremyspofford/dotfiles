#!/usr/bin/env python3
"""Small, file-only transaction layer around chezmoi's rendered target state."""
import argparse
import base64
import contextlib
import datetime
import difflib
import fcntl
import hashlib
import html
import io
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import uuid

REPO = Path(__file__).resolve().parent.parent
BREWFILE = REPO / "manifests/Brewfile.core"
LOCAL_GITCONFIG = ".config/git/local.gitconfig"
COMPONENTS = {
    "shell": [".zshenv", ".zprofile", ".zshrc", ".profile", ".bash_profile", ".bashrc",
              ".config/workbench/shell/env.sh", ".config/workbench/shell/common.sh",
              ".config/workbench/shell/completion.zsh"],
    "git": [".gitconfig", ".config/git/ignore"],
    "mise": [".config/mise/config.toml"],
    "tmux": [".tmux.conf"],
    "nvim": [".config/nvim/init.lua"],
    "workbench": [".local/bin/workbench", ".config/chezmoi/chezmoi.toml"],
}
# Opt-in components pin their tool in mise's conf.d. A component counts as chosen
# when any of its files is present; the default plan covers core plus chosen ones.
OPTIONAL = {
    "herdr": [".config/mise/conf.d/herdr.toml", ".config/herdr/config.toml"],
    "zoetrope": [".config/mise/conf.d/zoetrope.toml"],
}
OPTIONAL_TOOLS = {"herdr": "herdr", "zoetrope": "zoe"}
CORE_TOOLS = ("chezmoi", "mise", "tmux", "nvim", "git", "delta")
COMPONENTS.update(OPTIONAL)
ALLOWED = {p for paths in COMPONENTS.values() for p in paths}


def chosen(home):
    return [c for c, paths in OPTIONAL.items() if any(os.path.lexists(home / p) for p in paths)]


def default_components(home):
    return [c for c in COMPONENTS if c not in OPTIONAL] + chosen(home)


def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()


def file_state(path):
    if not os.path.lexists(path):
        return {"kind": "absent"}
    mode = stat.S_IMODE(path.lstat().st_mode)
    if path.is_symlink():
        result = {"kind": "symlink", "link": os.readlink(path)}
        # Keep both the link and its contents; never restore through the link.
        if path.is_file():
            result["resolved"] = base64.b64encode(path.read_bytes()).decode()
        return result
    if not path.is_file():
        raise ValueError(f"Refusing non-file target: {path}")
    return {"kind": "file", "mode": mode,
            "data": base64.b64encode(path.read_bytes()).decode()}


def checked_path(home, name):
    if name not in ALLOWED:
        raise ValueError(f"Target is not allowed: {name}")
    path = home / name
    for parent in path.parents:
        if parent == home:
            break
        if parent.is_symlink() or (parent.exists() and not parent.is_dir()):
            raise ValueError(f"Refusing redirected parent: {parent}")
    return path


def render(home, names):
    if not shutil.which("chezmoi"):
        raise ValueError("chezmoi is required; run mise install")
    with tempfile.TemporaryDirectory(prefix="workbench-render-") as tmp:
        tmp = Path(tmp)
        # Rendering must not depend on the caller's umask (checkpoints use 077).
        (tmp / "config.toml").write_text("umask = 0o022\n")
        command = ["chezmoi", "--source", str(REPO / "chezmoi"),
                   "--destination", str(home), "--config", str(tmp / "config.toml"),
                   "--cache", str(tmp / "cache"), "--persistent-state", str(tmp / "state.boltdb"),
                   "--no-tty", "archive", "--format", "tar", "--exclude", "scripts",
                   *[str(home / n) for n in names]]
        result = subprocess.run(command, check=True, capture_output=True)
        desired = {}
        with tarfile.open(fileobj=io.BytesIO(result.stdout)) as archive:
            for entry in archive:
                name = entry.name.removeprefix("./")
                if entry.isdir():
                    continue
                if name not in names or not entry.isfile():
                    raise ValueError(f"Unexpected archive entry: {name}")
                desired[name] = {"kind": "file", "mode": entry.mode & 0o777,
                                 "data": base64.b64encode(archive.extractfile(entry).read()).decode()}
        if set(desired) != set(names):
            raise ValueError("Rendered targets do not match the selected component manifest")
        return desired


def make_plan(home, names, existing):
    desired = render(home, names)
    before = {n: file_state(checked_path(home, n)) for n in names}
    changes = {n: desired[n] for n in names if before[n] != desired[n]
               and (existing == "replace" or before[n]["kind"] == "absent")}
    return {"destination": str(home), "existing": existing,
            "before": before, "desired": desired, "changes": changes}


def doctor(home, root):
    print(f"Source: {REPO / 'chezmoi'}\nDestination: {home}\nState: {root}")
    selected = chosen(home)
    tools = {name: shutil.which(name)
             for name in (*CORE_TOOLS, *(OPTIONAL_TOOLS[c] for c in selected))}
    for name, path in tools.items():
        print(f"{name}: {path or 'not installed'}")
    for component in OPTIONAL:
        print(f"Optional {component}: {'chosen' if component in selected else 'not chosen'}")
    print("Configuration transactions only; package installation/rollback is separate.")
    packages_ok = check_packages()
    identity_ok = check_identity(home, tools["git"])
    if not tools["chezmoi"]:
        print("Configuration: unable to check without chezmoi.")
        return 1
    names = sorted({n for c in default_components(home) for n in COMPONENTS[c]})
    plan = make_plan(home, names, "replace")
    for name in plan["changes"]:
        status = "MISSING" if plan["before"][name]["kind"] == "absent" else "DRIFT"
        print(f"{status:14} {name}")
    if plan["changes"]:
        print(f"Configuration: {len(plan['changes'])} managed file(s) need attention.")
        print("Review with workbench plan --existing replace"
              " (use the same --destination if checking another directory).")
    else:
        print("Configuration: all managed files match.")
    return int(bool(plan["changes"]) or not all(tools.values()) or packages_ok is False
               or identity_ok is False)


def check_identity(home, git):
    """The local Git include carries the identity; the shared config has none."""
    path = home / LOCAL_GITCONFIG
    if not path.is_file():
        print(f"Identity: MISSING {path}; copy docs/examples/local.gitconfig")
        return False
    if not git:
        print("Identity: unable to check without git.")
        return None
    result = subprocess.run([git, "config", "--file", str(path), "user.email"],
                            capture_output=True, text=True)
    if result.returncode or not result.stdout.strip():
        print(f"Identity: user.email is not set in {path}")
        return False
    print(f"Identity: {path} sets user.email.")
    return True


def check_packages():
    """Report Brewfile entries that are not installed; newer upstream versions are not drift."""
    missing = missing_packages()
    if missing is None:
        print("Packages: unable to check without Homebrew.")
        return None
    if not missing:
        print(f"Packages: all {BREWFILE.name} entries are installed.")
        return True
    for name in missing:
        print(f"MISSING        {name}")
    print(f"Packages: install with brew bundle install --file {BREWFILE}")
    return False


def contents(state):
    data = state.get("data", state.get("resolved", ""))
    return base64.b64decode(data).decode("utf-8", errors="replace").splitlines(keepends=True)


def show_plan(plan, color="auto", output_format="text"):
    output = []
    for name, desired in plan["desired"].items():
        before = plan["before"][name]
        action = "UNCHANGED" if before == desired else "SKIP existing"
        if name in plan["changes"]:
            action = "REMOVE" if desired["kind"] == "absent" else (
                "CREATE" if before["kind"] == "absent" else "REPLACE")
        output.append(f"{action:14} {name}\n")
        if name in plan["changes"]:
            if before["kind"] == "symlink":
                output.append(f"  Detach symlink {before['link']}; its source stays untouched.\n")
            if desired["kind"] == "symlink":
                output.append(f"  Restore symlink -> {desired['link']}\n")
            elif desired["kind"] == "file" and before.get("mode") != desired["mode"]:
                output.append(f"  File mode: {desired['mode']:04o}\n")
            output.extend(difflib.unified_diff(contents(before), contents(desired),
                                             fromfile=f"before/{name}", tofile=f"after/{name}"))
    output.append(f"\nPlan: {digest(plan)}\n")
    text = "".join(output)

    def style(line):
        if line.startswith(("---", "+++", "@@")):
            return "meta"
        if line.startswith("+"):
            return "added"
        if line.startswith("-"):
            return "removed"
        if line.startswith(("CREATE ", "REPLACE ", "REMOVE ", "UNCHANGED ", "SKIP existing", "Plan:")):
            return "heading"
        return "context"

    if output_format == "html":
        rows = "".join(f'<span class="{style(line)}">{html.escape(line)}</span>'
                       for line in text.splitlines(keepends=True))
        print('''<!doctype html>
<html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Workbench configuration diff</title>
<style>
:root { color-scheme: dark; }
body { background: #111827; color: #e5e7eb; margin: 0; padding: 28px; font: 16px system-ui, sans-serif; }
h1 { font-size: 24px; margin: 0 0 12px; }
p { color: #cbd5e1; }
pre { background: #0b1220; border: 1px solid #334155; border-radius: 8px; padding: 20px; overflow-x: auto;
      font: 14px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace; tab-size: 4; }
.added { color: #86efac; background: #123023; }
.removed { color: #fda4af; background: #381b25; }
.meta { color: #7dd3fc; }
.heading { color: #fde68a; font-weight: bold; }
</style><h1>Workbench configuration diff</h1>
<p>Review only — these changes have not been applied.</p>
<p><span class="added">+ Additions</span> &nbsp; <span class="removed">− Removals</span>
 &nbsp; <span class="meta">File and section markers</span></p><pre>''' + rows + '</pre></html>')
        return
    enabled = color == "always" or (color == "auto" and sys.stdout.isatty()
                                     and not os.environ.get("NO_COLOR") and os.environ.get("TERM") != "dumb")
    if enabled:
        colors = {"added": "32", "removed": "31", "meta": "36", "heading": "1;33"}
        text = "".join(f"\033[{colors[style(line)]}m{line.rstrip(chr(10))}\033[0m" + ("\n" if line.endswith("\n") else "")
                       if style(line) in colors else line for line in text.splitlines(keepends=True))
    print(text, end="", flush=True)


def atomic_json(path, value):
    atomic_write(path, json.dumps(value, indent=2).encode() + b"\n", 0o600)


def atomic_write(path, data, mode):
    fd, tmp = tempfile.mkstemp(prefix=".workbench-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
            os.fchmod(stream.fileno(), mode)
        os.replace(tmp, path)
    finally:
        if os.path.lexists(tmp):
            os.unlink(tmp)


def install_state(path, state):
    path.parent.mkdir(parents=True, exist_ok=True)
    if state["kind"] == "absent":
        if os.path.lexists(path):
            path.unlink()
    elif state["kind"] == "symlink":
        tmp = path.parent / (".workbench-" + uuid.uuid4().hex)
        try:
            tmp.symlink_to(state["link"])
            os.replace(tmp, path)
        finally:
            if os.path.lexists(tmp):
                tmp.unlink()
    else:
        atomic_write(path, base64.b64decode(state["data"]), state["mode"])


@contextlib.contextmanager
def locked(root):
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    if root.resolve() != root or root.stat().st_mode & 0o077:
        raise ValueError(f"State directory must be private (0700), not a symlink: {root}")
    with (root / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield


def checkpoint(root, home, before, after, label):
    ident = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid.uuid4().hex[:8]
    directory = root / "checkpoints" / ident
    directory.mkdir(parents=True, mode=0o700)
    missing = set()
    for name in before:
        for parent in (home / name).parents:
            if parent == home:
                break
            if not parent.exists():
                missing.add(str(parent.relative_to(home)))
    commit = subprocess.run(["git", "-C", str(REPO), "rev-parse", "HEAD"], capture_output=True, text=True)
    entry = {"version": 1, "id": ident, "label": label, "destination": str(home),
             "source_commit": commit.stdout.strip(), "before": before, "after": after,
             "created_directories": sorted(missing), "status": "prepared"}
    atomic_json(directory / "checkpoint.json", entry)
    print(f"Checkpoint: {directory}", flush=True)
    return directory, entry


def rollback_plan(home, entry, replace_edits=False):
    if entry["destination"] != str(home):
        raise ValueError("Checkpoint belongs to a different destination")
    allowed_dirs = {str(p) for n in entry["before"] for p in Path(n).parents if str(p) != "."}
    if not set(entry["created_directories"]).issubset(allowed_dirs):
        raise ValueError("Checkpoint contains unexpected directory cleanup paths")
    current = {n: file_state(checked_path(home, n)) for n in entry["before"]}
    for name, state in current.items():
        if not replace_edits and state not in (entry["before"][name], entry["after"][name]):
            raise ValueError(f"{name} changed since the transaction; preserve/merge that edit before rollback")
        previous = entry["before"][name]
        if previous["kind"] == "symlink" and "resolved" in previous:
            link = Path(previous["link"])
            target = link if link.is_absolute() else (home / name).parent / link
            if not target.is_file() or base64.b64encode(target.read_bytes()).decode() != previous["resolved"]:
                raise ValueError(f"Original symlink source changed: {name}; checkpoint includes its saved contents")
    return {"checkpoint": entry["id"], "destination": str(home), "before": current,
            "desired": entry["before"], "changes": {n: s for n, s in entry["before"].items() if current[n] != s}}


def restore(home, entry, replace_edits=False):
    # Validate every path and drift condition before restoring any file.
    plan = rollback_plan(home, entry, replace_edits)
    for name, state in plan["changes"].items():
        install_state(checked_path(home, name), state)
    for name in sorted(entry["created_directories"], key=lambda n: n.count("/"), reverse=True):
        directory = home / name
        if directory.is_symlink():
            raise ValueError(f"Refusing changed directory: {directory}")
        try:
            directory.rmdir()
        except OSError:
            pass  # Never remove a nonempty directory or unrelated contents.


# Interactive selection. Decisions live in plain functions so they can be tested
# without a terminal; the curses layer only collects choices.
MISE_SOURCE = REPO / "chezmoi/dot_config/mise"
OPTIONAL_DESCRIPTIONS = {"herdr": "Herdr terminal workspace", "zoetrope": "zoe: live flow graph of a Claude Code session"}
PIN = re.compile(r'^(?P<key>"[^"]+"|[A-Za-z0-9_.:/@+-]+)\s*=\s*"(?P<version>[^"]+)"\s*(#.*)?$')


def pin_source(component):
    return MISE_SOURCE / ("config.toml" if component is None else f"conf.d/{component}.toml")


def read_pins(path):
    pins, section = {}, None
    for line in path.read_text().splitlines():
        stripped = line.strip()
        if stripped.startswith("["):
            section = stripped
        elif section == "[tools]" and (match := PIN.match(stripped)):
            pins[match["key"].strip('"')] = match["version"]
    return pins


def set_pin(text, tool, old, new):
    """Change exactly one [tools] pin; refuse anything ambiguous."""
    lines, section, hits = text.splitlines(keepends=True), None, []
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("["):
            section = stripped
        elif section == "[tools]" and (match := PIN.match(stripped)) \
                and match["key"].strip('"') == tool and match["version"] == old:
            hits.append(index)
    if len(hits) != 1:
        raise ValueError(f"Expected one pin {tool} = {old!r}, found {len(hits)}")
    lines[hits[0]] = lines[hits[0]].replace(f'"{old}"', f'"{new}"', 1)
    return "".join(lines)


def fetch_outdated():
    """Newest release per live pin; empty when offline or mise is unavailable."""
    if not shutil.which("mise"):
        return {}
    try:
        result = subprocess.run(["mise", "outdated", "--bump", "--json"], capture_output=True,
                                text=True, timeout=90)
        return json.loads(result.stdout) if result.returncode == 0 and result.stdout.strip() else {}
    except (subprocess.TimeoutExpired, json.JSONDecodeError):
        return {}


def inventory(outdated):
    rows = []
    for component in (None, *OPTIONAL):
        source = pin_source(component)
        if not source.is_file():
            continue
        for tool, version in read_pins(source).items():
            latest = (outdated.get(tool) or {}).get("bump")
            rows.append({"component": component, "tool": tool, "pinned": version,
                         "latest": latest if latest and latest != version else None})
    return rows


def selection_changes(current, choices, bumps, rows):
    """Translate checklist state into components to write, remove, and pins to bump."""
    add = [c for c in OPTIONAL if choices[c] and c not in current]
    remove = [c for c in OPTIONAL if not choices[c] and c in current]
    bump_rows = [r for r in rows if r["tool"] in bumps and r["latest"]
                 and (r["component"] is None or choices[r["component"]])]
    touched = set(add) | {r["component"] or "mise" for r in bump_rows}
    return {"add": add, "remove": remove, "bumps": bump_rows, "touched": sorted(touched)}


def selection_plan(home, changes):
    names = sorted({n for c in changes["touched"] for n in COMPONENTS[c]})
    plan = make_plan(home, names, "replace") if names else {
        "destination": str(home), "existing": "replace", "before": {}, "desired": {}, "changes": {}}
    for component in changes["remove"]:
        for name in COMPONENTS[component]:
            before = file_state(checked_path(home, name))
            if before["kind"] != "absent":
                plan["before"][name] = before
                plan["desired"][name] = plan["changes"][name] = {"kind": "absent"}
    return plan


def missing_packages():
    """None without Homebrew; otherwise the Brewfile entries that are not installed."""
    brew = shutil.which("brew")
    if not brew:
        return None
    result = subprocess.run([brew, "bundle", "check", "--no-upgrade", "--verbose", "--file", str(BREWFILE)],
                            capture_output=True, text=True)
    if result.returncode == 0:
        return []
    return [line.lstrip("→ ").split(" needs")[0]
            for line in (result.stdout + result.stderr).splitlines() if line.startswith("→")]


def checklist(screen, rows, choices, footer):
    """Curses checklist. Returns (choices, bumps), or None when cancelled."""
    import curses
    choices, bumps = dict(choices), set()
    items = [("header", "Core (always installed)")]
    items += [("tool", r) for r in rows if r["component"] is None]
    items.append(("header", "Optional (Space to choose)"))
    for component in OPTIONAL:
        items.append(("component", component))
        items += [("tool", r) for r in rows if r["component"] == component]
    selectable = [i for i, (kind, value) in enumerate(items) if kind == "component"
                  or (kind == "tool" and value["latest"])]
    cursor, top = 0, 0
    with contextlib.suppress(curses.error):
        curses.curs_set(0)
    while True:
        height, width = screen.getmaxyx()
        body = max(1, height - 4)
        current = selectable[cursor] if selectable else -1
        top = min(max(top, current - body + 1), max(current, 0)) if selectable else 0
        screen.erase()
        lines = []
        for index, (kind, value) in enumerate(items):
            if kind == "header":
                lines.append((index, value, curses.A_BOLD))
            elif kind == "component":
                mark = "[x]" if choices[value] else "[ ]"
                lines.append((index, f"{mark} {value:<12} {OPTIONAL_DESCRIPTIONS.get(value, '')}", 0))
            else:
                indent = "      " if value["component"] else "  "
                if value["latest"]:
                    mark = "[u]" if value["tool"] in bumps else "[ ]"
                    status = f"{value['pinned']} -> {value['latest']}"
                else:
                    mark, status = "   ", f"{value['pinned']}  up to date" if value["component"] is None \
                        or choices[value["component"]] else value["pinned"]
                lines.append((index, f"{indent}{mark} {value['tool']:<28} {status}", 0))
        for row, (index, text, attr) in enumerate(lines[top:top + body]):
            if index == current:
                attr |= curses.A_REVERSE
            with contextlib.suppress(curses.error):
                screen.addnstr(row, 0, text, width - 1, attr)
        for offset, text in enumerate(("Up/Down move   Space choose or mark update   Enter review   q cancel", footer)):
            with contextlib.suppress(curses.error):
                screen.addnstr(height - 2 + offset, 0, text, width - 1, curses.A_DIM)
        screen.refresh()
        key = screen.getch()
        if key in (ord("q"), 27):
            return None
        if key in (10, 13, curses.KEY_ENTER):
            return choices, bumps
        if key in (curses.KEY_UP, ord("k")) and cursor > 0:
            cursor -= 1
        elif key in (curses.KEY_DOWN, ord("j")) and cursor < len(selectable) - 1:
            cursor += 1
        elif key in (ord(" "), ord("u")) and selectable:
            kind, value = items[selectable[cursor]]
            if kind == "component":
                choices[value] = not choices[value]
            else:
                bumps ^= {value["tool"]}


def has_terminal():
    return sys.stdin.isatty() and sys.stdout.isatty()


def interactive_apply(root, home, color):
    import curses
    if not has_terminal():
        raise ValueError("--interactive needs a terminal; use plan and apply --plan instead")
    print("Checking mise for newer releases...", flush=True)
    rows = inventory(fetch_outdated())
    current = chosen(home)
    packages = missing_packages()
    footer = ("Homebrew: unavailable" if packages is None else
              "Homebrew bootstrap: all installed (read-only)" if not packages else
              f"Homebrew bootstrap missing (read-only): {', '.join(packages)}")
    picked = curses.wrapper(checklist, rows, {c: c in current for c in OPTIONAL}, footer)
    if picked is None:
        print("Cancelled; nothing changed.")
        return
    changes = selection_changes(current, *picked, rows)
    if not (changes["add"] or changes["remove"] or changes["bumps"]):
        print("Nothing selected; nothing changed.")
        return
    originals = {}
    try:
        # Pins live in the repository so every machine converges on the same versions.
        for row in changes["bumps"]:
            source = pin_source(row["component"])
            originals.setdefault(source, source.read_text())
            source.write_text(set_pin(source.read_text(), row["tool"], row["pinned"], row["latest"]))
        plan = selection_plan(home, changes)
        show_plan(plan, color)
        if input("Apply these changes? [y/N] ").strip().lower() not in ("y", "yes"):
            raise KeyboardInterrupt
        with locked(root):
            if digest(selection_plan(home, changes)) != digest(plan):
                raise ValueError("Files changed while reviewing; nothing applied")
            apply_plan(root, home, plan)
    except KeyboardInterrupt:
        for source, text in originals.items():
            source.write_text(text)
        print("\nCancelled; nothing changed.")
        return
    except BaseException:
        for source, text in originals.items():
            source.write_text(text)
        raise
    if changes["add"] or changes["bumps"]:
        subprocess.run(["mise", "install"], check=True)
    for component in changes["remove"]:
        for tool, version in read_pins(pin_source(component)).items():
            subprocess.run(["mise", "uninstall", f"{tool}@{version}"], check=False)
    if originals:
        print("Pins changed in the repository; review and commit them:")
        for source in originals:
            print(f"  git -C {REPO} diff -- {source.relative_to(REPO)}")


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--destination", type=Path, default=Path.home())
    parser.add_argument("--state-dir", type=Path, default=Path.home() / ".local/state/workbench")
    parser.add_argument("--color", choices=["auto", "always", "never"], default="auto",
                        help="color terminal diffs; auto respects NO_COLOR and redirected output")
    commands = parser.add_subparsers(dest="command", required=True)
    for name in ("plan", "apply", "checkpoint"):
        sub = commands.add_parser(name)
        sub.add_argument("--components", nargs="+", choices=COMPONENTS,
                         help="default: core components plus optional ones already chosen")
        sub.add_argument("--existing", choices=["skip", "replace"], default="skip")
        if name == "apply":
            sub.add_argument("--plan", help="exact hash printed by plan")
            sub.add_argument("--interactive", action="store_true",
                             help="choose optional tools and updates in a checklist, then review and confirm")
        elif name == "plan":
            sub.add_argument("--format", choices=["text", "html"], default="text",
                             help="export a readable color diff with --format html")
    sub = commands.add_parser("rollback")
    sub.add_argument("id")
    sub.add_argument("--plan", help="omit to preview; supply preview hash to restore")
    sub.add_argument("--replace-edits", action="store_true", help="explicitly preview/restore over later edits")
    commands.add_parser("checkpoints")
    commands.add_parser("doctor")
    args = parser.parse_args()
    home = args.destination.expanduser().absolute()
    if home.is_symlink() or not home.is_dir() or home.resolve() != home:
        raise ValueError("Destination must be an existing directory with no symlink ancestors")
    root = args.state_dir.expanduser().absolute()
    if args.command == "doctor":
        return doctor(home, root)
    if args.command == "checkpoints":
        for path in sorted((root / "checkpoints").glob("*/checkpoint.json")):
            entry = json.loads(path.read_text())
            print(entry["id"], entry["status"], entry["label"])
        return
    if args.command == "rollback":
        if not args.id or Path(args.id).name != args.id or args.id in (".", ".."):
            raise ValueError("Invalid checkpoint id")
        with locked(root):
            path = root / "checkpoints" / args.id / "checkpoint.json"
            entry = json.loads(path.read_text())
            plan = rollback_plan(home, entry, args.replace_edits)
            show_plan(plan, args.color)
            if args.plan is None:
                return
            if args.plan != digest(plan):
                raise ValueError("Rollback plan is stale; preview it again")
            if plan["changes"]:
                recovery_path, recovery = checkpoint(root, home, plan["before"], plan["desired"], "before-rollback")
                restore(home, entry, args.replace_edits)
                recovery["status"] = "applied"
                atomic_json(recovery_path / "checkpoint.json", recovery)
            entry["status"] = "rolled-back"
            atomic_json(path, entry)
        return
    if args.command == "apply" and args.interactive:
        if args.plan or args.components:
            raise ValueError("--interactive chooses components itself; omit --plan and --components")
        return interactive_apply(root, home, args.color)
    if args.command == "apply" and not args.plan:
        raise ValueError("apply needs --plan <hash> from workbench plan, or --interactive")
    names = sorted({n for c in (args.components or default_components(home)) for n in COMPONENTS[c]})
    if args.command == "plan":
        show_plan(make_plan(home, names, args.existing), args.color, args.format)
        return
    with locked(root):
        plan = make_plan(home, names, args.existing)
        if args.command == "checkpoint":
            checkpoint(root, home, plan["before"], plan["before"], "manual")
            return
        if args.plan != digest(plan):
            raise ValueError("Plan is stale or options differ; run plan again before applying")
        show_plan(plan, args.color)
        apply_plan(root, home, plan)


def apply_plan(root, home, plan):
    """Checkpoint, install, and verify; restores every file if any step fails. Caller holds the lock."""
    if not plan["changes"]:
        print("No changes.")
        return None
    before = {n: plan["before"][n] for n in plan["changes"]}
    directory, entry = checkpoint(root, home, before, plan["changes"], "before-apply")
    try:
        for name, desired in plan["changes"].items():
            path = checked_path(home, name)
            if file_state(path) != before[name]:
                raise ValueError(f"Target changed during apply: {name}")
            install_state(path, desired)
        if any(file_state(home / n) != s for n, s in plan["changes"].items()):
            raise ValueError("Post-apply verification failed")
        entry["status"] = "applied"
    except BaseException:
        try:
            restore(home, entry)
            entry["status"] = "failed-restored"
        except Exception as error:
            entry["status"] = "recovery-required"
            print(f"Automatic restore stopped: {error}; use checkpoint {entry['id']}", file=sys.stderr)
        raise
    finally:
        atomic_json(directory / "checkpoint.json", entry)
    print("Applied and verified. Rollback id:", entry["id"])
    return entry["id"]


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"workbench: {error}", file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError) and error.stderr:
            print(error.stderr.decode() if isinstance(error.stderr, bytes) else error.stderr, file=sys.stderr)
        sys.exit(1)
