{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(mise:*)",
      "Bash(bun:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(uv:*)",
      "Bash(stow:*)",
      "Bash(ssh:*)",
      "Bash(ssh-keygen:*)",
      "Bash(ssh-add:*)",
      "Bash(curl:*)",
      "Bash(jq:*)",
      "Bash(make:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)"
    ]
  },
  "autoUpdatesChannel": "stable",
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"[\\(now | strftime(\"%Y-%m-%d %H:%M:%S\"))] \\(.tool_input.command)\"' >> ~/.claude/bash-log.txt",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v notify-send >/dev/null 2>&1; then notify-send 'Claude Code' 'Needs your attention' --icon=dialog-information 2>/dev/null; elif command -v osascript >/dev/null 2>&1; then osascript -e 'display notification \"Needs your attention\" with title \"Claude Code\"' 2>/dev/null; fi"
          }
        ]
      }
    ]
  }
}
