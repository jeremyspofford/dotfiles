{
  "permissions": {
    "allow": [
      "Bash(docker buildx:*)",
      "Bash(docker builder:*)",
      "Bash(sudo service:*)",
      "Bash(git init)",
      "Bash(git remote add origin git@github.com:arialabs/nova.git)",
      "Bash(git config --global user.name)",
      "Bash(git config --global user.email)"
    ],
    "defaultMode": "default"
  },
  "model": "sonnet",
