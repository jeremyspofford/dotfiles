# These are template-time OS branches, not runtime guesses.
{{ if eq .chezmoi.os "darwin" -}}
# macOS: support Apple Silicon and Intel Homebrew without requiring either.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi
export DOTFILES_PLATFORM=darwin
{{ else if eq .chezmoi.os "linux" -}}
{{ if or (env "WSL_DISTRO_NAME") (env "WSL_INTEROP") -}}
# WSL uses Linux tools and paths; Windows-native agents are managed separately.
export DOTFILES_PLATFORM=wsl
{{ else -}}
# Native Linux: no distribution-specific package manager is assumed here.
# WSL shells launched without WSL_* environment variables still identify correctly.
if [[ -r /proc/version ]] && grep -qi microsoft /proc/version; then
  export DOTFILES_PLATFORM=wsl
else
  export DOTFILES_PLATFORM=linux
fi
{{ end -}}
{{ else if eq .chezmoi.os "windows" -}}
# Native Windows: template example for zsh in a POSIX shell.
# Bootstrap is supported under WSL, not native PowerShell.
export DOTFILES_PLATFORM=windows
{{ else -}}
# Other OSes retain portable shell defaults.
export DOTFILES_PLATFORM=unknown
{{ end -}}
