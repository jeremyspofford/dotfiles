{{- $domain := promptStringOnce . "domain" "Domain (core: shared; personal: shared+personal; work: shared+employer; client: shared+client)" "core" -}}
{{- if not (has $domain (list "core" "personal" "work" "client")) -}}
{{- fail "domain must be core, personal, work, or client" -}}
{{- end }}
{{- /* Capture once, before apply. An explicit empty map also counts as saved data. */ -}}
{{- $tools := dict -}}
{{- $pinsSource := get . "misePinsSource" | default "saved machine data" -}}
{{- if hasKey . "miseTools" -}}
{{- $tools = .miseTools -}}
{{- else -}}
{{- $miseConfig := joinPath .chezmoi.homeDir ".config/mise/config.toml" -}}
{{- if stat $miseConfig -}}
{{- $existing := include $miseConfig | fromToml -}}
{{- if hasKey $existing "tools" -}}{{- $tools = $existing.tools -}}{{- end -}}
{{- if not (kindIs "map" $tools) -}}
{{- fail "Existing Mise [tools] must be a tool-to-version table." -}}
{{- end -}}
{{- end -}}
{{- $pinsSource = "existing global config" -}}
{{- if not $tools -}}
{{- $pinsSource = "defaults from installed Node/Python; no downloads" -}}
{{- if lookPath "mise" -}}
{{- range $tool := list "node" "python" -}}
{{- $version := output "mise" "latest" "--installed" "--cd" $.chezmoi.homeDir $tool | trim -}}
{{- if $version -}}{{- $_ := set $tools $tool $version -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
{{- if not (kindIs "map" $tools) -}}
{{- fail "Mise pins must be a tool-to-version table in [data.miseTools] or [tools]." -}}
{{- end }}
# Define target permissions independently of the invoking shell's umask.
# Keep managed files/directories private (0600/0700), including on later applies.
# The private_ source attribute also explicitly protects .secrets.
umask = 0o077
# Persist the initialized checkout so bare chezmoi commands work in any shell.
sourceDir = {{ .chezmoi.sourceDir | quote }}

# Machine data survives init and apply. Store references here, never secret values.
{{ dict "data" (dict
    "domain" $domain
    "gitName" (promptStringOnce . "gitName" "Git name (commit author; blank=unset)" "")
    "gitEmail" (promptStringOnce . "gitEmail" "Git email (commit author email; blank=unset)" "")
    "secretsEnabled" (get . "secretsEnabled" | default false)
    "secretReference" (get . "secretReference" | default "op://Example/Development/api-token")
    "miseTools" $tools
    "misePinsSource" $pinsSource
) | toToml }}
